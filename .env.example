# Copiar como ".env" y ajustar valores. Nunca commitear el ".env" real.

# Postgres (usado por docker-compose y por el backend)
POSTGRES_DB=credit_scoring
POSTGRES_USER=credit_scoring
POSTGRES_PASSWORD=credit_scoring

# Backend -> datasource (debe apuntar al mismo Postgres de arriba)
DB_URL=jdbc:postgresql://localhost:5432/credit_scoring
DB_USERNAME=credit_scoring
DB_PASSWORD=credit_scoring

# JWT: el secreto debe tener al menos 32 caracteres (HS256). Generar uno propio, p. ej.:
#   openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=3600000

# Usuario ADMIN inicial (se crea una sola vez, al arrancar, si no existe ningún usuario)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
